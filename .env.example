PORT=8000
DATABASE_URL=postgresql://agrogis:change-me@localhost:5432/agrogis
PGSSL=disable
PGPOOL_MAX=10
JWT_SECRET=replace-this-with-a-long-random-secret
# Optional: Apino.sk API key for RPO org + people lookup (server-side only; never commit the real key)
APINO_API_KEY=apino_replace_with_your_key

# Supabase. Publishable key may be in the browser. Never put the secret key in HTML or JS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
